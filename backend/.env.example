PORT=5000
NODE_ENV=development

# PostgreSQL / Supabase Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication (Minimum 32 characters long)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: Google Calendar OAuth 2.0 Integration (Server-Side Secrets)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Enable: Google Calendar API in Google Cloud Console
# Authorized redirect URI: http://localhost:5000/api/calendar/callback
GOOGLE_CLIENT_ID=your_google_calendar_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events.readonly
